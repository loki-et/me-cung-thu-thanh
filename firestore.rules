rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each player's own progress: only they can read or write it.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'stars', 'times', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 14
        && request.resource.data.stars is list && request.resource.data.stars.size() <= 21
        && request.resource.data.times is map && request.resource.data.times.size() <= 20;
    }

    // Leaderboard: anyone can read; a player can only write their own entry, and only a faster time.
    match /lb/{lv}/runs/{uid} {
      function valid() {
        let d = request.resource.data;
        return request.auth != null && request.auth.uid == uid
          && lv.matches('^([1-9]|1[0-9]|20)$')
          && d.keys().hasOnly(['name', 't', 'st', 'at'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 14
          && d.t is int && d.t >= 300 && d.t < 100000
          && d.st is int && d.st >= 1 && d.st <= 3
          && d.at == request.time;
      }
      allow read: if true;
      allow create: if valid();
      allow update: if valid() && request.resource.data.t <= resource.data.t;
    }
  }
}
